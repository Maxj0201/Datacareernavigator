---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { ROLES } from "../data/roles.ts";
import { SKILLS } from "../data/skills.ts";
import { RESOURCES } from "../data/resources.ts";
import { QUIZ } from "../data/quiz.ts";
import { u } from "../lib/url.ts";
import { radarSvg } from "../lib/radar.ts";

const sample = ROLES.find((r) => r.slug === "data-analyst")!;
const axes = SKILLS.slice(0, 8);
const preview = radarSvg(
  axes.map((s) => s.short),
  [
    { label: "Data Analyst target", values: axes.map((s) => sample.skills[s.id] ?? 0), className: "radar-target" },
    { label: "Example learner", values: [2, 3, 1, 2, 2, 1, 1, 0], className: "radar-you" },
  ],
);

const tools = [
  { icon: "compass", title: "Career quiz", text: `${QUIZ.length} questions about what you enjoy. Get your best-fit roles, with the reasons.`, href: "quiz" },
  { icon: "gauge", title: "Skill check", text: `Rate yourself on ${SKILLS.length} core skills and see your readiness for every role.`, href: "skills" },
  { icon: "map", title: "Personal roadmap", text: "A step-by-step checklist built from your skill gaps. Progress saves automatically.", href: "roadmap" },
  { icon: "scale", title: "Compare roles", text: "Put two roles side by side: skills, tools, pay and how people get in.", href: "compare" },
  { icon: "spark", title: "Knowledge check", text: "Ten quick concept questions with explanations to test the basics.", href: "knowledge-check" },
  { icon: "book", title: "Resource library", text: `${RESOURCES.length} curated courses, books and practice sites, filterable by skill and cost.`, href: "resources" },
] as const;
---
<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Free · No sign-up · About 5 minutes</p>
        <h1>Find the data career that fits you.</h1>
        <p class="lead">Analyst, data engineer, data scientist, AI engineer? Discover which role suits how you like to work, see how close your skills already are, and get a concrete plan for what to learn next.</p>
        <div class="row">
          <a class="btn btn-primary" href={u("quiz")}>Take the career quiz <Icon name="arrow" size={18} /></a>
          <a class="btn btn-secondary" href={u("roles")}>Browse the roles</a>
        </div>
      </div>
      <div class="hero-panel card">
        <div class="row" style="justify-content:space-between;margin-bottom:6px">
          <strong>Example: skills vs. Data Analyst</strong>
          <span class="badge badge-accent">Preview</span>
        </div>
        <Fragment set:html={preview} />
        <div class="legend"><span class="l-you">Your ratings</span><span class="l-target">Role target</span></div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="stat-strip">
        <div class="stat"><b>{ROLES.length}</b><span class="muted">data roles explained</span></div>
        <div class="stat"><b>{SKILLS.length}</b><span class="muted">skills mapped to each role</span></div>
        <div class="stat"><b>{RESOURCES.length}</b><span class="muted">curated learning resources</span></div>
        <div class="stat"><b>0</b><span class="muted">accounts or data collected</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>From "I like data" to a plan you can follow</h2>
        <div class="steps" style="margin-top:24px">
          <div class="step"><span class="step-num">1</span><div><h3>Discover</h3><p class="muted">The career quiz scores your interests across eight dimensions, from investigating data to building software, and matches them to each role.</p></div></div>
          <div class="step"><span class="step-num">2</span><div><h3>Assess</h3><p class="muted">The skill check compares your self-ratings with what each role expects of a solid early-career hire.</p></div></div>
          <div class="step"><span class="step-num">3</span><div><h3>Plan</h3><p class="muted">Your roadmap lists the next concrete step for each gap, with free resources first. Tick items off as you go.</p></div></div>
        </div>
      </div>
      <div class="card">
        <h3>Not sure where to start?</h3>
        <p class="muted">Most people begin with the quiz. If you already have a target role, jump straight to the skill check.</p>
        <div class="stack">
          <a class="btn btn-primary" style="width:100%" href={u("quiz")}>Start with the quiz</a>
          <a class="btn btn-secondary" style="width:100%" href={u("skills")}>I know my target: check my skills</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Explore</p>
      <div class="row" style="justify-content:space-between;align-items:end;margin-bottom:20px">
        <h2 style="margin:0">Eight data roles, explained</h2>
        <a href={u("roles")}>See all roles →</a>
      </div>
      <div class="grid grid-4">
        {ROLES.map((r) => (
          <a class="card card-link" href={u(`roles/${r.slug}`)}>
            <h3>{r.title}</h3>
            <p class="muted small">{r.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Toolkit</p>
      <h2>Interactive tools</h2>
      <div class="grid grid-3" style="margin-top:20px">
        {tools.map((t) => (
          <a class="card card-link" href={u(t.href)}>
            <div class="icon-tile"><Icon name={t.icon} /></div>
            <h3>{t.title}</h3>
            <p class="muted">{t.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
